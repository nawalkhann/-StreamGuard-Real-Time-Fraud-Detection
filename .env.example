# Copy to .env and edit. All variables use the STREAMGUARD_ prefix.
# Comma-separated API keys accepted in the X-API-Key header (generate with: python -c "import secrets;print(secrets.token_urlsafe(32))")
STREAMGUARD_API_KEYS=change-me
STREAMGUARD_DB_PATH=data/streamguard.db
STREAMGUARD_MODEL_PATH=models/model.joblib
# Score >= REVIEW goes to analysts, >= DECLINE is declined
STREAMGUARD_REVIEW_THRESHOLD=0.50
STREAMGUARD_DECLINE_THRESHOLD=0.85
# Optional Kafka ingestion (requires: pip install -e '.[kafka]')
# STREAMGUARD_KAFKA_BOOTSTRAP=localhost:9092
